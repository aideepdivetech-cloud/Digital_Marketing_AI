# ============================================================================
# DIGITAL MARKETING AI AGENT PLATFORM — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ── Application ──
APP_NAME=digital-marketing-ai
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_ai
POSTGRES_USER=marketing_ai_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ── Qdrant (Vector DB) ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── MinIO (Object Storage) ──
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_DEFAULT_BUCKET=artifacts

# ── Ollama (LLM Server) ──
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://${OLLAMA_HOST}:${OLLAMA_PORT}
BOSS_AGENT_MODEL=llama3.2:3b-instruct-q4_K_M
SUB_AGENT_MODEL=llama3.2:1b-instruct-q4_K_M
FALLBACK_MODEL=llama3.2:1b-instruct-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# ── JWT Auth ──
JWT_SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Celery ──
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500
MAX_CONCURRENT_TASKS_PER_USER=5

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# ── Frontend (Future) ──
FRONTEND_URL=http://localhost:3000
