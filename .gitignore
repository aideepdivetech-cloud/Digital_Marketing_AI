# ============================================================================
# Digital Marketing AI Platform — Git Ignore
# ============================================================================

# ── Environment & Secrets ──
.env
.env.local
.env.production
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.Python
pip-log.txt

# ── Virtual Environments ──
venv/
env/
.venv/
ENV/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Node.js (Frontend — Phase 4) ──
node_modules/
.next/
out/
.cache/
npm-debug.log*

# ── Logs ──
logs/
*.log

# ── OS Files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Storage (generated at runtime) ──
artifacts/
backups/
storage/

# ── Ollama Models (too large for Git) ──
models/

# ── Test & Coverage ──
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage.xml

# ── Celery ──
celerybeat-schedule
celerybeat.pid

# ── Misc ──
*.bak
*.tmp
*.temp
